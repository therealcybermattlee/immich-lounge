namespace tests
  @suite("Utils Helpers")
  class UtilsTests extends rooibos.BaseTestSuite

    @describe("TruncateStr")

    @it("Short string is returned unchanged")
    function test_truncateShort()
      m.assertEqual(TruncateStr("hello", 10), "hello")
    end function

    @it("Long string is truncated to maxLen")
    function test_truncateLong()
      m.assertEqual(TruncateStr("hello world", 5), "hello")
    end function

    @describe("Clamp")

    @it("Value below min returns min")
    function test_clampMin()
      m.assertEqual(Clamp(-5.0, 0.0, 10.0), 0.0)
    end function

    @it("Value above max returns max")
    function test_clampMax()
      m.assertEqual(Clamp(15.0, 0.0, 10.0), 10.0)
    end function

    @it("Value in range is returned unchanged")
    function test_clampMid()
      m.assertEqual(Clamp(5.0, 0.0, 10.0), 5.0)
    end function

    @describe("BuildMediaUrl")

    @it("Photo with preview quality")
    function test_mediaUrlPhotoPreview()
      entry = { id: "abc123", type: "photo" }
      profile = { immich: { serverUrl: "http://192.168.1.10:2283" }, imageQuality: "preview" }
      m.assertEqual(BuildMediaUrl(entry, profile), "http://192.168.1.10:2283/api/assets/abc123/thumbnail?size=preview")
    end function

    @it("Photo with original quality")
    function test_mediaUrlPhotoOriginal()
      entry = { id: "abc123", type: "photo" }
      profile = { immich: { serverUrl: "http://192.168.1.10:2283" }, imageQuality: "original" }
      m.assertEqual(BuildMediaUrl(entry, profile), "http://192.168.1.10:2283/api/assets/abc123/original")
    end function

    @it("Video uses video/playback endpoint")
    function test_mediaUrlVideo()
      entry = { id: "vid001", type: "video" }
      profile = { immich: { serverUrl: "http://192.168.1.10:2283" }, imageQuality: "preview" }
      m.assertEqual(BuildMediaUrl(entry, profile), "http://192.168.1.10:2283/api/assets/vid001/video/playback")
    end function

    @it("Live photo uses livePhotoVideoId")
    function test_mediaUrlLivePhoto()
      entry = { id: "photo001", type: "livePhoto", livePhotoVideoId: "video001" }
      profile = { immich: { serverUrl: "http://192.168.1.10:2283" }, imageQuality: "preview" }
      m.assertEqual(BuildMediaUrl(entry, profile), "http://192.168.1.10:2283/api/assets/video001/video/playback")
    end function

    @describe("BuildStillMediaUrl")

    @it("Photo passes through to BuildMediaUrl")
    function test_stillUrlPhoto()
      entry = { id: "abc123", type: "photo" }
      profile = { immich: { serverUrl: "http://192.168.1.10:2283" }, imageQuality: "original" }
      m.assertEqual(BuildStillMediaUrl(entry, profile), "http://192.168.1.10:2283/api/assets/abc123/original")
    end function

    @it("Video returns the preview still, not the playback URL")
    function test_stillUrlVideo()
      entry = { id: "vid001", type: "video" }
      profile = { immich: { serverUrl: "http://192.168.1.10:2283" }, imageQuality: "preview" }
      m.assertEqual(BuildStillMediaUrl(entry, profile), "http://192.168.1.10:2283/api/assets/vid001/thumbnail?size=preview")
    end function

    @it("Live photo returns the still asset's preview")
    function test_stillUrlLivePhoto()
      entry = { id: "photo001", type: "livePhoto", livePhotoVideoId: "video001" }
      profile = { immich: { serverUrl: "http://192.168.1.10:2283" }, imageQuality: "preview" }
      m.assertEqual(BuildStillMediaUrl(entry, profile), "http://192.168.1.10:2283/api/assets/photo001/thumbnail?size=preview")
    end function

    @describe("BuildBackgroundMediaUrl")

    @it("Photo uses the small thumbnail")
    function test_bgUrlPhoto()
      entry = { id: "abc123", type: "photo" }
      profile = { immich: { serverUrl: "http://192.168.1.10:2283" }, imageQuality: "preview" }
      m.assertEqual(BuildBackgroundMediaUrl(entry, profile), "http://192.168.1.10:2283/api/assets/abc123/thumbnail?size=thumbnail")
    end function

    @it("Video uses its thumbnail, never the playback URL")
    function test_bgUrlVideo()
      entry = { id: "vid001", type: "video" }
      profile = { immich: { serverUrl: "http://192.168.1.10:2283" }, imageQuality: "preview" }
      m.assertEqual(BuildBackgroundMediaUrl(entry, profile), "http://192.168.1.10:2283/api/assets/vid001/thumbnail?size=thumbnail")
    end function

    @describe("GetVideoStreamFormat")

    @it("Progressive playback URL defaults to mp4")
    function test_streamFormatMp4()
      m.assertEqual(GetVideoStreamFormat("http://192.168.1.10:2283/api/assets/vid001/video/playback"), "mp4")
    end function

    @it("HLS manifest is detected by extension")
    function test_streamFormatHls()
      m.assertEqual(GetVideoStreamFormat("http://192.168.1.10:2283/api/assets/vid001/master.m3u8"), "hls")
    end function

    @describe("BuildVideoContentFields")

    @it("Carries the API key as an HttpHeaders entry, not in the URL")
    function test_videoContentAuthHeader()
      entry = { id: "vid001", type: "video" }
      profile = { immich: { serverUrl: "http://192.168.1.10:2283", apiKey: "secret123" } }
      fields = BuildVideoContentFields(entry, profile)
      m.assertEqual(fields.url, "http://192.168.1.10:2283/api/assets/vid001/video/playback")
      m.assertEqual(fields.streamFormat, "mp4")
      m.assertEqual(fields.httpHeaders[0], "x-api-key: secret123")
      m.assertEqual(Instr(1, fields.url, "secret123"), 0)
    end function

    @it("Omits headers when no API key is configured")
    function test_videoContentNoKey()
      entry = { id: "vid001", type: "video" }
      profile = { immich: { serverUrl: "http://192.168.1.10:2283" } }
      fields = BuildVideoContentFields(entry, profile)
      m.assertInvalid(fields.httpHeaders)
    end function

    @it("HTTPS servers get a certificate bundle")
    function test_videoContentHttpsCerts()
      entry = { id: "vid001", type: "video" }
      profile = { immich: { serverUrl: "https://immich.example.com", apiKey: "secret123" } }
      fields = BuildVideoContentFields(entry, profile)
      m.assertEqual(fields.httpCertificatesFile, "common:/certs/ca-bundle.crt")
    end function

    @describe("WmoToIconName")

    @it("WMO code 0 maps to clear")
    function test_wmoClear()
      m.assertEqual(WmoToIconName(0), "clear")
    end function

    @it("WMO code 45 maps to fog")
    function test_wmoFog()
      m.assertEqual(WmoToIconName(45), "fog")
    end function

    @it("WMO code 71 maps to snow")
    function test_wmoSnow()
      m.assertEqual(WmoToIconName(71), "snow")
    end function

  end class
end namespace
